{
  "routes": [
    {
      "route": "/Reports.html",
      "redirect": "/Dashboards.html",
      "statusCode": 301
    },
    {
      "route": "/dashboard/*",
      "redirect": "/Dashboards.html",
      "statusCode": 301
    },
    {
      "route": "/dashboard2/*",
      "redirect": "/Dashboards.html",
      "statusCode": 301
    },
    {
      "route": "/dashboard3/*",
      "redirect": "/Dashboards.html",
      "statusCode": 301
    },
    {
      "route": "/dashboard4/*",
      "redirect": "/Dashboards.html",
      "statusCode": 301
    },
    {
      "route": "/dashboard5/*",
      "redirect": "/Dashboards.html",
      "statusCode": 301
    },
    {
      "route": "/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/google"
    }
  },
  "auth": {
    "identityProviders": {
      "google": {
        "registration": {
          "clientIdSettingName": "GOOGLE_CLIENT_ID",
          "clientSecretSettingName": "GOOGLE_CLIENT_SECRET"
        }
      }
    }
  }
}
